# 大模型配置：很多厂商使用 OpenAI 兼容接口，但 base_url 不同。
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=

# 向量模型配置：与大模型配置独立，方便使用不同厂商。
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_BATCH_SIZE=25

# 兼容旧配置：当 LLM_API_KEY 或 EMBEDDING_API_KEY 为空时作为兜底。
OPENAI_API_KEY=

CHROMA_PERSIST_DIRECTORY=./persist/chroma
