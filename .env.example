# ── LLM 配置 ──────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=

# ── 向量模型配置 ──────────────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_BATCH_SIZE=25

# ── Chroma 持久化 ─────────────────────────
CHROMA_PERSIST_DIRECTORY=./persist/chroma

# ⚠ 安全提示：
#   1. 推荐使用 Streamlit Secrets 替代 .env 文件（优先级最高）
#   2. .env 文件已加入 .gitignore，切勿提交到版本库
#   3. 使用 Streamlit Secrets 时，创建 .streamlit/secrets.toml 并设置对应值
#   4. .streamlit/secrets.toml 也必须加入 .gitignore
